#!/bin/sh
# Pre-push leak tripwire — scans the committed HEAD tree AND the commit-message
# range about to be pushed (tree scans never see commit-message-only residue —
# see scripts/leak-scan.sh --range), and refuses to push under a non-noreply
# author identity. Installed via `scripts/install-hooks.sh`.
#
# The range pass is also the ONLY tripwire a merge commit gets: git does not run
# pre-commit for merges, so a merge's own message reaches history unscanned until
# this hook sees it (`git rev-list <range>` includes merge commits).
ROOT=$(git rev-parse --show-toplevel)
if [ -x "$ROOT/scripts/leak-scan.sh" ]; then
  sh "$ROOT/scripts/leak-scan.sh" --head || {
    echo "pre-push BLOCKED by leak-scan (tree). Override (after review) with: git push --no-verify" >&2
    exit 1
  }
  ZERO=0000000000000000000000000000000000000000
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue  # branch delete — nothing to scan
    if [ "$remote_sha" = "$ZERO" ]; then
      RANGE="$local_sha --not --remotes"    # new ref — scan whatever isn't on any remote yet
    else
      RANGE="$remote_sha..$local_sha"
    fi
    STATUS=0
    sh "$ROOT/scripts/leak-scan.sh" --range $RANGE || STATUS=$?
    # Exit 3 = the range held 0 commits. That is a legitimate state here (a new
    # ref whose tip already exists on another remote publishes no new messages),
    # so it does not block — but it is ANNOUNCED, never silently read as clean.
    case "$STATUS" in
      0) ;;
      3) echo "pre-push NOTE — 0 commit messages scanned for $local_ref (empty range); the HEAD-tree scan above still applies." >&2 ;;
      *) echo "pre-push BLOCKED by leak-scan (commit log for $local_ref). Override (after review) with: git push --no-verify" >&2
         exit 1 ;;
    esac
  done
fi
EMAIL=$(git config user.email)
case "$EMAIL" in
  *users.noreply.github.com) ;;
  *) echo "pre-push BLOCKED — non-noreply author email configured: $EMAIL" >&2; exit 1 ;;
esac
exit 0
